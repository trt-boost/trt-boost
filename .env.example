# ----------------------------------------------------------------------------
# TRT Boost — environment variables
# Copy to `.env.local` and fill in. NEXT_PUBLIC_* values are exposed to the
# browser; everything else stays server-side only.
# ----------------------------------------------------------------------------

# Lobbie clinical intake / booking handoff.
# Every "Get Started" / "Start Visit" CTA links here. Replace with your real
# Lobbie intake or booking URL.
NEXT_PUBLIC_LOBBIE_INTAKE_URL="https://app.lobbie.com/"

# Public site URL. NOTE: not read by the code — the canonical URL is set in
# `src/lib/site.ts` (`site.url`). Kept here for reference only.
# NEXT_PUBLIC_SITE_URL="https://www.trtboost.com"

# ----------------------------------------------------------------------------
# Private preview (for partner review before launch)
# ----------------------------------------------------------------------------
# Password-protect the whole site (HTTP Basic Auth). Set these in your host's
# env (e.g., Vercel). Leave PREVIEW_PASSWORD blank to disable the gate.
# PREVIEW_USER="partner"
# PREVIEW_PASSWORD="choose-a-strong-password"

# Search-engine indexing. Leave unset (or anything but "false") to BLOCK search
# engines while previewing. Set to "false" only at public launch.
# NEXT_PUBLIC_NOINDEX="false"

# Google Analytics 4 (optional). When set, GA4 loads and tracks page views +
# events. Leave blank in dev to keep analytics off.
# NEXT_PUBLIC_GA_ID="G-XXXXXXXXXX"

# Tawk.to live chat (optional). When both are set, the chat widget loads and
# the "Chat now" buttons open it. Copy them from Tawk.to → Administration →
# Chat Widget; the widget code looks like https://embed.tawk.to/PROPERTY_ID/WIDGET_ID
# NEXT_PUBLIC_TAWK_PROPERTY_ID="xxxxxxxxxxxxxxxxxxxxxxxx"
# NEXT_PUBLIC_TAWK_WIDGET_ID="1xxxxxxxxx"

# ----------------------------------------------------------------------------
# Stripe (payments) — enables on-site checkout via /api/checkout + the webhook
# at /api/webhooks/stripe. Optional: without these, the Lobbie handoff is used.
# Use a HIGH-RISK / healthcare-approved account or get written approval for your
# model before going live (telehealth + Rx = high-risk). See README.
# ----------------------------------------------------------------------------
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_live_xxx"
# STRIPE_SECRET_KEY="sk_live_xxx"
# STRIPE_WEBHOOK_SECRET="whsec_xxx"   # from the Stripe webhook endpoint

# ----------------------------------------------------------------------------
# Lobbie API (for future server-side sync of orders/patients). Optional.
# ----------------------------------------------------------------------------
# LOBBIE_API_BASE_URL="https://api.lobbie.com"
# LOBBIE_API_KEY="xxx"
